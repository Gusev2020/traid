# Copy to .env and fill locally. Never commit real values.

# ─── PostgreSQL (Prisma + postgres MCP read-only) ─────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=trading_dashboard
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trading_dashboard?schema=public

# ─── Backend ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=1A2CN0p0UlHHICGpVhbY3B5rqWISVWgGlCXR4eMjft+TJvX0JOXjvcRJkqbYN+aG
JWT_REFRESH_SECRET=P2skfBRXrOOSmhM5OHVCA55EtKnPP7Zren+fFAaG1PsualhU5DXyGZdkIYAyMaaI
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── CoinGecko ─────────────────────────────────────────────────────────────────
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
COINGECKO_RATE_LIMIT_PER_MIN=50
COINGECKO_CACHE_TTL_MS=60000
CANDLE_SYNC_INTERVAL_MS=60000

# ─── Frontend (inlined at build time) ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:3001
NEXT_PUBLIC_DEFAULT_SYMBOL=BTC
OPENAPI_INPUT=http://localhost:3001/docs-json

# ─── Cursor MCP (optional; empty CONTEXT7_API_KEY = rate-limited free tier) ────
CONTEXT7_API_KEY=
GITHUB_PERSONAL_ACCESS_TOKEN=
FIGMA_API_KEY=
